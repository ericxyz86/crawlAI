# AI Web Crawler - Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# Required: Deepseek API Key (Primary LLM for content extraction)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Required: SerpAPI Key (Google search functionality)
SERP_API_KEY=your_serpapi_key_here

# Required: Firecrawl API Key (Web scraping service)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: OpenAI API Key (Fallback LLM for o4-mini model)
OPENAI_API_KEY=your_openai_api_key_here_optional

# Optional: Port configuration (default: 5001)
# PORT=5001

# Optional: Render deployment flag (automatically set in production)
# RENDER=true
